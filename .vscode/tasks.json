{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Angular: serve",
      "type": "npm",
      "script": "start",
      "args": [
        "--",
        "--host",
        "127.0.0.1",
        "--port",
        "4200"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*(Application bundle generation complete|Local:).*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Angular: build",
      "type": "npm",
      "script": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$tsc"
    }
  ]
}
